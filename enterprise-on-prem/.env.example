# Copy this file to `.env` in THIS folder, then fill in the values below.
#
# Docker Compose reads `.env` from the directory it runs in, so it must sit next
# to docker-compose.yml. A .env at the repository root is NOT read.
#
# Kubernetes does not read this file at all; see Part 2 of the README.

# Used to download the 3lc, 3lc-dashboard and 3lc-hub-frontend wheels from the private 3LC
# package repository. Build-time only: they are passed to the build as build secrets, so
# they are absent from both the running containers and the built images.
TLC_PYPI_ACCESS_KEY=
TLC_PYPI_SECRET_KEY=

# Used for 3LC license authentication at startup of Object Service.
TLC_LICENSE=

# Used to authenticate requests from the 3LC Dashboard to the Object Service.
# Must be identical for both.
TLC_OBJECT_SERVICE_AUTH_SECRET=
